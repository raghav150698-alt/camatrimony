# ============================================================
# CA Matrimony BNCN — Required Environment Variables
# Copy this file to .env (root) or use `wrangler secret put`
# for values that must not be committed.
# ============================================================

# --- Web App (Next.js / Pages) ---
NEXT_PUBLIC_API_BASE_URL=https://camatrimony-api.gentle-mode-2ab9.workers.dev/v1

# Local review only. See LOCAL_REVIEW.md; leave disabled in deployed environments.
NEXT_PUBLIC_LOCAL_REVIEW=false
LOCAL_REVIEW_AUTH=false

# Firebase client config
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxx

# Razorpay public key for checkout
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxx

# --- Admin App (Next.js / Pages) ---
NEXT_PUBLIC_API_BASE_URL=https://camatrimony-api.gentle-mode-2ab9.workers.dev/v1

# --- API Worker (Hono on Cloudflare Workers) ---
# Firebase admin verification
FIREBASE_PROJECT_ID=your-firebase-project-id

# Admin JWT (min 32 random bytes)
ADMIN_JWT_SECRET=generate-a-secure-random-secret-min-32-chars

# Razorpay server credentials
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxx

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxx
FROM_EMAIL=noreply@camatrimonybncn.com

# CORS origins (comma-separated in API middleware)
CORS_ORIGIN=https://camatrimonybncn.com,https://admin.camatrimonybncn.com

# Set to development to allow mock payment paths locally; omit in production.
ENVIRONMENT=production
