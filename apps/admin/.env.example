# Public environment variables for the admin app (admin.camatrimonybncn.com)
# These are read by Next.js at build time and exposed to the browser.
# Copy this file to .env.local and fill in the real values.

NEXT_PUBLIC_API_BASE_URL=https://camatrimony-api.gentle-mode-2ab9.workers.dev/v1
NEXT_PUBLIC_FIREBASE_API_KEY=...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=...
NEXT_PUBLIC_FIREBASE_PROJECT_ID=...
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=...
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=...
NEXT_PUBLIC_FIREBASE_APP_ID=...

# Supabase Auth only; database/files/backend remain on Cloudflare.
# Set this in both apps together with AUTH_PROVIDER=supabase on the API after identity mapping.
NEXT_PUBLIC_AUTH_PROVIDER=supabase
NEXT_PUBLIC_SUPABASE_URL=https://ulwijnfaktabzhhvuvyv.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
