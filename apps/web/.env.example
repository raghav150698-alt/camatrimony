# Public environment variables for the web app (camatrimonybncn.com)
# These are read by Next.js at build time and exposed to the browser.
# Copy this file to .env.local and fill in the real values.

NEXT_PUBLIC_API_BASE_URL=https://camatrimony-api.gentle-mode-2ab9.workers.dev/v1
NEXT_PUBLIC_FIREBASE_API_KEY=...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ca-matrimony-bncn.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ca-matrimony-bncn
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ca-matrimony-bncn.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=...
NEXT_PUBLIC_FIREBASE_APP_ID=...
NEXT_PUBLIC_RAZORPAY_KEY_ID=...

# --- Firebase Phone Auth (Console checklist — not set in code) ---
# Project: ca-matrimony-bncn (must be on Blaze for live SMS)
# Auth → Sign-in method → Phone: ENABLED
# Auth → Settings → Authorized domains must include:
#   camatrimonybncn.com
#   www.camatrimonybncn.com
#   camatrimony-web.pages.dev
#   (plus any *.camatrimony-web.pages.dev preview hosts you use)
# Auth → Settings → SMS region policy: allow India (IN / +91)
# Auth → Sign-in method → Phone → Phone numbers for testing:
#   Add QA numbers + fixed codes so agents/devs do not burn SMS quota
# Google Cloud → APIs → Credentials → Browser key HTTP referrers:
#   https://camatrimonybncn.com/*
#   https://www.camatrimonybncn.com/*
#   https://camatrimony-web.pages.dev/*
#   https://*.camatrimony-web.pages.dev/*
#   http://localhost:*
